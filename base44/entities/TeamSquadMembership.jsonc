{
  "name": "TeamSquadMembership",
  "type": "object",
  "properties": {
    "team_type": {
      "type": "string",
      "enum": [
        "club",
        "national"
      ]
    },
    "team_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "shirt_number": {
      "type": "integer"
    },
    "primary_position": {
      "type": "string"
    },
    "secondary_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "squad_role": {
      "type": "string",
      "enum": [
        "starter",
        "rotation",
        "bench",
        "reserve",
        "loan"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "injured",
        "suspended",
        "unavailable"
      ]
    },
    "sort_order": {
      "type": "integer"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "team_type",
    "team_id",
    "player_id",
    "season"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}