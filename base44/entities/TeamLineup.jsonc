{
  "name": "TeamLineup",
  "type": "object",
  "properties": {
    "team_type": {
      "type": "string",
      "enum": [
        "club",
        "national",
        "standalone"
      ],
      "description": "standalone identifica onces libres que no se vinculan a ning\u00fan equipo."
    },
    "team_id": {
      "type": "string",
      "description": "ID del equipo del once o 'standalone' cuando el once es libre."
    },
    "season": {
      "type": "string",
      "description": "Vac\u00edo en los onces libres sin equipo."
    },
    "name": {
      "type": "string"
    },
    "formation": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "custom",
        "ideal",
        "latest",
        "historical",
        "predicted",
        "official"
      ]
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "manager_id": {
      "type": "string",
      "description": "Entrenador asociado al once. Opcional."
    },
    "manager_name": {
      "type": "string",
      "description": "Nombre del entrenador en el momento de guardar, para mostrarlo sin consultas adicionales."
    }
  },
  "required": [
    "team_type",
    "team_id",
    "name",
    "formation"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}