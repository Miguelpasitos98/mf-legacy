{
  "name": "ImportJob",
  "type": "object",
  "properties": {
    "job_key": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "fotmob_player_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "review",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "queued"
    },
    "phase": {
      "type": "string"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "source_results": {
      "type": "object"
    },
    "requested_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    },
    "worker_version": {
      "type": "string"
    },
    "retry_count": {
      "type": "integer",
      "default": 0
    },
    "claim_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "heartbeat_at": {
      "type": "string"
    },
    "lease_expires_at": {
      "type": "string"
    },
    "received_candidates": {
      "type": "integer",
      "default": 0
    },
    "completed_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_pending": {
      "type": "boolean",
      "default": false
    },
    "review_lock_id": {
      "type": "string"
    },
    "review_lock_until": {
      "type": "string"
    },
    "retry_scopes": {
      "type": "object"
    },
    "root_job_id": {
      "type": "string"
    }
  },
  "required": [
    "job_key",
    "player_id",
    "sources",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}