{
  "name": "StatsViewPreference",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Ajustes de columnas y f\u00f3rmulas de STATS"
    },
    "config_json": {
      "type": "string",
      "description": "Configuraci\u00f3n personal serializada, validada al cargar"
    },
    "version": {
      "type": "number"
    }
  },
  "required": [
    "key",
    "config_json"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}