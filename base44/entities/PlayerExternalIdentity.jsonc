{
  "name": "PlayerExternalIdentity",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "api_sports"
      ]
    },
    "provider_player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "verification": {
      "type": "string",
      "enum": [
        "manual"
      ]
    },
    "birth_date": {
      "type": "string"
    }
  },
  "required": [
    "player_id",
    "provider",
    "provider_player_id",
    "verification"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}