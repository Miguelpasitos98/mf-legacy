{
  "name": "ProviderSeasonCandidate",
  "type": "object",
  "properties": {
    "candidate_key": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "api_sports"
      ]
    },
    "provider_player_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "provider_season": {
      "type": "integer"
    },
    "competition": {
      "type": "string"
    },
    "provider_league_id": {
      "type": "string"
    },
    "provider_team_id": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "appearances": {
      "type": "integer"
    },
    "minutes": {
      "type": "integer"
    },
    "rating": {
      "type": "number"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "conflict",
        "rejected"
      ],
      "default": "pending"
    },
    "source_url": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "source_payload_hash": {
      "type": "string"
    }
  },
  "required": [
    "candidate_key",
    "player_id",
    "source",
    "provider_player_id",
    "season",
    "competition",
    "provider_league_id",
    "provider_team_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}