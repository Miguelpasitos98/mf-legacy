              "description": "Centros (0-20)"
            },
            "regate": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Regate (0-20)"
            },
            "remate": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Remate (0-20)"
            },
            "control": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Control (0-20)"
            },
            "tiros_libres": {
              "type": "number",
