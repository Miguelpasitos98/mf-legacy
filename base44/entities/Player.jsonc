              "type": "number",
              "description": "Movimiento/desmarques, 0-20; se alimenta desde la columna Desmarques"
            },
            "colocacion": {
              "type": "number",
              "description": "Colocaci\u00f3n, 0-20; copia directa del export"
            },
            "trabajo_de_equipo": {
              "type": "number",
