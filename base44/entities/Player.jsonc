{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo del jugador"
    },
    "date_of_birth": {
      "type": "string",
      "description": "Fecha de nacimiento en formato DD/MM/YYYY"
    },
    "team_id": {
      "type": "string",
      "description": "ID del club asociado al jugador"
    },
    "country_id": {
      "type": "string",
      "description": "ID del pa\u00eds asociado al jugador"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del jugador para el perfil individual"
    },
    "card_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del jugador utilizada en las tarjetas del listado de jugadores cuando se muestran en contexto de club"
    },
    "national_card_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del jugador con la camiseta de su selecci\u00f3n nacional, utilizada en las tarjetas del listado cuando los jugadores se agrupan por pa\u00edses"
    },
    "ca": {
      "type": "number",
      "description": "Current Ability (CA) del jugador"
    },
    "cp": {
      "type": "number",
      "description": "Potential Ability (CP) del jugador"
    },
    "position_ratings": {
      "type": "object",
      "properties": {
        "GK": {
          "type": "number",
          "description": "Valoraci\u00f3n como portero (0-20)"
        },
        "DFC": {
          "type": "number",
          "description": "Valoraci\u00f3n como defensa central (0-20)"
        },
        "LD": {
          "type": "number",
          "description": "Valoraci\u00f3n como lateral derecho (0-20)"
        },
        "LI": {
          "type": "number",
          "description": "Valoraci\u00f3n como lateral izquierdo (0-20)"
        },
        "CRD": {
          "type": "number",
          "description": "Valoraci\u00f3n como carrilero derecho (0-20)"
        },
        "CRI": {
          "type": "number",
          "description": "Valoraci\u00f3n como carrilero izquierdo (0-20)"
        },
        "CDM": {
          "type": "number",
          "description": "Valoraci\u00f3n como mediocentro defensivo (0-20)"
        },
        "CM": {
          "type": "number",
          "description": "Valoraci\u00f3n como mediocentro (0-20)"
        },
        "CAM": {
          "type": "number",
          "description": "Valoraci\u00f3n como mediapunta (0-20)"
        },
        "EI": {
          "type": "number",
          "description": "Valoraci\u00f3n como extremo izquierdo (0-20)"
        },
        "ED": {
          "type": "number",
          "description": "Valoraci\u00f3n como extremo derecho (0-20)"
        },
        "DC": {
          "type": "number",
          "description": "Valoraci\u00f3n como delantero centro (0-20)"
        }
      },
      "description": "Valoraci\u00f3n del jugador en cada posici\u00f3n del campo"
    },
    "stats": {
      "type": "object",
      "properties": {
        "mental": {
          "type": "object",
          "properties": {
            "agresividad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Agresividad (0-20)"
            },
            "anticipacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Anticipaci\u00f3n (0-20)"
            },
            "valentia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Valent\u00eda (0-20)"
            },
            "serenidad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Serenidad (0-20)"
            },
            "concentracion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Concentraci\u00f3n (0-20)"
            },
            "consistencia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Consistencia (0-20)"
            },
            "decisiones": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Decisiones (0-20)"
            },
            "determinacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Determinaci\u00f3n (0-20)"
            },
            "juego_sucio": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Juego sucio (0-20)"
            },
            "talento": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Talento (0-20)"
            },
            "partidos_importantes": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Partidos importantes (0-20)"
            },
            "liderazgo": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Liderazgo (0-20)"
            },
            "movimiento": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Movimiento (0-20)"
            },
            "colocacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Colocaci\u00f3n (0-20)"
            },
