{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo del jugador"
    },
    "date_of_birth": {
      "type": "string",
      "description": "Fecha de nacimiento en formato DD/MM/YYYY"
    },
    "team_id": {
      "type": "string",
      "description": "ID del club asociado al jugador"
    },
    "country_id": {
      "type": "string",
      "description": "ID del país asociado al jugador"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la fotografía del jugador para el perfil individual"
    },
    "card_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del jugador utilizada en las tarjetas del listado de jugadores cuando se muestran en contexto de club"
    },
    "national_card_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del jugador con la camiseta de su selección nacional, utilizada en las tarjetas del listado cuando los jugadores se agrupan por países"
    },
    "ca": {
      "type": "number",
      "description": "Current Ability (CA) del jugador"
    },
    "cp": {
      "type": "number",
      "description": "Potential Ability (CP) del jugador"
    },
    "style": {
      "type": "string",
      "description": "Estilo de juego del jugador"
    },
    "height": {
      "type": "number",
      "description": "Altura del jugador en centímetros"
    },
    "right_foot": {
      "type": "string",
      "description": "Nivel de uso de la pierna derecha"
    },
    "left_foot": {
      "type": "string",
      "description": "Nivel de uso de la pierna izquierda"
    },
    "shirt_number": {
      "type": "number",
      "description": "Dorsal del jugador"
    },
    "salary": {
      "type": "number",
      "description": "Salario anual del jugador"
    },
    "position_raw": {
      "type": "string",
      "description": "Posición original tal como aparece en Football Manager"
    },
    "position": {
      "type": "string",
      "description": "Posición principal normalizada de MF LEGACY"
    },
    "secondary_position_raw": {
      "type": "string",
      "description": "Posición secundaria original tal como aparece en Football Manager"
    },
    "secondary_position": {
      "type": "string",
      "description": "Posición secundaria normalizada de MF LEGACY"
    },
    "position_ratings": {
      "type": "object",
      "properties": {
        "GK": {
          "type": "number",
          "description": "Valoración como portero (0-20)"
        },
        "DFC": {
          "type": "number",
          "description": "Valoración como defensa central (0-20)"
        },
        "LD": {
          "type": "number",
          "description": "Valoración como lateral derecho (0-20)"
        },
        "LI": {
          "type": "number",
          "description": "Valoración como lateral izquierdo (0-20)"
        },
        "CRD": {
          "type": "number",
          "description": "Valoración como carrilero derecho (0-20)"
        },
        "CRI": {
          "type": "number",
          "description": "Valoración como carrilero izquierdo (0-20)"
        },
        "CDM": {
          "type": "number",
          "description": "Valoración como mediocentro defensivo (0-20)"
        },
        "CM": {
          "type": "number",
          "description": "Valoración como mediocentro (0-20)"
        },
        "CAM": {
          "type": "number",
          "description": "Valoración como mediapunta (0-20)"
        },
        "EI": {
          "type": "number",
          "description": "Valoración como extremo izquierdo (0-20)"
        },
        "ED": {
          "type": "number",
          "description": "Valoración como extremo derecho (0-20)"
        },
        "DC": {
          "type": "number",
          "description": "Valoración como delantero centro (0-20)"
        }
      },
      "description": "Valoración del jugador en cada posición del campo"
    },
    "stats": {
      "type": "object",
      "properties": {
        "mental": {
          "type": "object",
          "properties": {
            "agresividad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Agresividad (0-20)"
            },
            "anticipacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Anticipación (0-20)"
            },
            "valentia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Valentía (0-20)"
            },
            "serenidad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Serenidad (0-20)"
            },
            "concentracion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Concentración (0-20)"
            },
            "consistencia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Consistencia (0-20)"
            },
            "decisiones": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Decisiones (0-20)"
            },
            "determinacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Determinación (0-20)"
            },
            "juego_sucio": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Juego sucio (0-20)"
            },
            "talento": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Talento (0-20)"
            },
            "partidos_importantes": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Partidos importantes (0-20)"
            },
            "liderazgo": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Liderazgo (0-20)"
            },
            "movimiento": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Movimiento (0-20)"
            },
            "colocacion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Colocación (0-20)"
            },
            "trabajo_de_equipo": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Trabajo de equipo (0-20)"
            },
            "vision": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Visión (0-20)"
            }
          },
          "description": "Atributos mentales del jugador. Todas las estadísticas tienen un rango de 0 a 20."
        },
        "physical": {
          "type": "object",
          "properties": {
            "aceleracion": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Aceleración (0-20)"
            },
            "agilidad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Agilidad (0-20)"
            },
            "balance": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Balance (0-20)"
            },
            "tendencia_a_lesionarse": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Tendencia a lesionarse (0-20)"
            },
            "alcance_de_salto": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Alcance de salto (0-20)"
            },
            "alcance_de_salto_recomendado_altura": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Alcance de salto recomendado basándose en la altura (0-20)"
            },
            "recuperacion_fisica": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Recuperación física (0-20)"
            },
            "velocidad": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Velocidad (0-20)"
            },
            "resistencia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Resistencia (0-20)"
            },
            "fuerza": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Fuerza (0-20)"
            }
          },
          "description": "Atributos físicos del jugador. Todas las estadísticas tienen un rango de 0 a 20."
        },
        "technical": {
          "type": "object",
          "properties": {
            "saques_de_esquina": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
