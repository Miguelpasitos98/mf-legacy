              "description": "Penaltis (0-20)"
            },
            "entradas": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Entradas (0-20)"
            },
            "tecnica": {
              "type": "number",
              "minimum": 0,
