            },
            "blocaje": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Blocaje (0-20)"
            },
            "saques_de_puerta": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Saques de puerta (0-20)"
            },
            "uno_contra_uno": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Uno contra uno (0-20)"
            },
            "reflejos": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Reflejos (0-20)"
            },
            "salidas_tendencia": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Salidas (tendencia) (0-20)"
            },
            "salida_de_puños": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Salida de puños (0-20)"
            },
            "saque_con_la_mano": {
              "type": "number",
              "minimum": 0,
