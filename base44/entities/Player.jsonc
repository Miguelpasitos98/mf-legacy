{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo del jugador"
    },
    "date_of_birth": {
      "type": "string",
      "description": "Fecha de nacimiento en formato DD/MM/YYYY"
    },
    "team_id": {
      "type": "string",
      "description": "ID del club asociado al jugador"
    },
    "country_id": {
      "type": "string",
      "description": "ID del país asociado al jugador"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la fotografía del jugador"
    }
  },
  "required": ["name"]
}
