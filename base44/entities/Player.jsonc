        },
        "goalkeeping": {
          "type": "object",
          "properties": {
            "balones_aereos": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Balones aéreos (0-20)"
            },
            "balones_aereos_recomendado_altura": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Balones aéreos recomendado basándose en la altura (0-20)"
            },
            "mando_en_el_area": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Mando en el área (0-20)"
            },
            "comunicacion": {
              "type": "number",
              "minimum": 0,
