              "description": "Cabeceo (0-20)"
            },
            "tiros_lejanos": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Tiros lejanos (0-20)"
            },
            "saques_largos": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Saques largos (0-20)"
            },
            "marcaje": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
              "description": "Marcaje (0-20)"
            },
            "pases": {
              "type": "number",
              "minimum": 0,
              "maximum": 20,
