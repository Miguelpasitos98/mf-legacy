{
  // Especificación del nuevo importador: Football Manager Editor -> MF LEGACY.
  // La fuente puede ser un CSV generado manualmente/por IA a partir de capturas.
  "source": {
    "canonical_delimiter": ",",
    "supported_delimiters": [",", ";", "\\t"],
    "encoding": "UTF-8",
    "columns_expected": 82,
    "note": "El importador detecta automáticamente el separador. Las columnas de posiciones proceden directamente de la pantalla POSICIONES del Editor y NO se interpretan."
  },
  "relations": {
    "country": {
      "source_column": "País",
      "target_field": "country_id",
      "strategy": "find_or_create",
      "match": ["normalized_name"],
      "create_defaults": {
        "is_active": true
      }
    },
    "team": {
      "source_column": "Equipo",
      "target_field": "team_id",
      "strategy": "find_or_create",
      "match": ["normalized_name", "country_id"],
      "fallback_match": ["normalized_short_name", "country_id"],
      "create_defaults": {
        "is_active": true
      },
      "note": "El equipo se toma literalmente del CSV."
    }
  },
  "direct_mappings": {
    "Jugador": "name",
    "Posición": "fm_position",
    "Mejores puestos": "best_positions",
    "Rol utilizado para rellenar atributos vacíos": "role_used_to_fill_empty_attributes",
    "Posición central preferida": "preferred_central_position",
    "Estilo": "style",
    "Pierna derecha": "right_foot",
    "Pierna izquierda": "left_foot",
    "CA": "ca",
    "CP": "cp",
    "Portero": "position_ratings.portero",
    "Defensa izquierdo": "position_ratings.defensa_izquierdo",
    "Defensa central": "position_ratings.defensa_central",
    "Defensa derecho": "position_ratings.defensa_derecho",
    "Mediocentro": "position_ratings.mediocentro",
    "Carrilero izquierdo": "position_ratings.carrilero_izquierdo",
    "Carrilero derecho": "position_ratings.carrilero_derecho",
    "Centrocampista izquierdo": "position_ratings.centrocampista_izquierdo",
    "Centrocampista": "position_ratings.centrocampista",
    "Centrocampista derecho": "position_ratings.centrocampista_derecho",
    "Mediapunta por la izquierda": "position_ratings.mediapunta_por_la_izquierda",
    "Mediapunta central": "position_ratings.mediapunta_central",
    "Mediapunta por la derecha": "position_ratings.mediapunta_por_la_derecha",
    "Delantero": "position_ratings.delantero",
    "Agresividad": "stats.mental.agresividad",
    "Anticipación": "stats.mental.anticipacion",
    "Valentía": "stats.mental.valentia",
    "Serenidad": "stats.mental.serenidad",
    "Concentración": "stats.mental.concentracion",
    "Decisiones": "stats.mental.decisiones",
    "Determinación": "stats.mental.determinacion",
    "Talento": "stats.mental.talento",
    "Liderazgo": "stats.mental.liderazgo",
    "Desmarques": "stats.mental.movimiento",
    "Colocación": "stats.mental.colocacion",
    "Trabajo de equipo": "stats.mental.trabajo_de_equipo",
    "Visión": "stats.mental.vision",
    "Sacrificio": "stats.mental.sacrificio",
    "Aceleración": "stats.physical.aceleracion",
    "Agilidad": "stats.physical.agilidad",
    "Equilibrio": "stats.physical.balance",
    "Alcance de salto": "stats.physical.alcance_de_salto",
    "Recuperación física": "stats.physical.recuperacion_fisica",
    "Velocidad": "stats.physical.velocidad",
    "Resistencia": "stats.physical.resistencia",
    "Fuerza": "stats.physical.fuerza",
    "Saques de esquina": "stats.technical.saques_de_esquina",
    "Centros": "stats.technical.centros",
    "Regate": "stats.technical.regate",
    "Remate": "stats.technical.remate",
    "Control": "stats.technical.control",
    "Tiros libres": "stats.technical.tiros_libres",
    "Cabeceo": "stats.technical.cabeceo",
    "Tiros lejanos": "stats.technical.tiros_lejanos",
    "Saques largos": "stats.technical.saques_largos",
    "Marcaje": "stats.technical.marcaje",
    "Pases": "stats.technical.pases",
    "Penaltis": "stats.technical.penaltis",
    "Entradas": "stats.technical.entradas",
    "Técnica": "stats.technical.tecnica",
    "Polivalencia": "stats.technical.polivalencia",
    "Alcance aéreo": "stats.goalkeeping.balones_aereos",
    "Mando en el área": "stats.goalkeeping.mando_en_el_area",
    "Comunicación": "stats.goalkeeping.comunicacion",
    "Excentricidad": "stats.goalkeeping.excentricidad",
    "Blocaje": "stats.goalkeeping.blocaje",
    "Saques de puerta": "stats.goalkeeping.saques_de_puerta",
    "Uno contra uno": "stats.goalkeeping.uno_contra_uno",
    "Puños": "stats.goalkeeping.salida_de_puños",
    "Reflejos": "stats.goalkeeping.reflejos",
    "Salidas (tendencia)": "stats.goalkeeping.salidas_tendencia",
    "Saque con la mano": "stats.goalkeeping.saque_con_la_mano",
    "Partidos importantes": "stats.mental.partidos_importantes",
    "Consistencia": "stats.mental.consistencia",
    "Juego sucio": "stats.mental.juego_sucio"
  },
  "transformations": {
    "Nacim.": {
      "target_field": "date_of_birth",
      "rule": "Parse D/M/YYYY and format as DD/MM/YYYY"
    },
    "Altura": {
      "target_field": "height",
      "rule": "Extract numeric centimeters from values such as '173 cm'"
    },
    "Sueldo": {
      "target_field": "salary",
      "rule": "Normalize decimal comma and K/M/B suffixes to an absolute numeric annual value"
    },
    "Nº": {
      "target_field": "shirt_number",
      "rule": "Parse integer; blank or nonnumeric becomes 0"
    },
    "Tendencia a lesionarse": {
      "target_field": "stats.physical.tendencia_a_lesionarse",
      "rule": "Invert the FM value: MF = 20 - FM, so 20 means greater resistance and 0 greater injury proneness"
    }
  },
  "preserve_source_fields_exactly": [
    "fm_position",
    "best_positions",
    "role_used_to_fill_empty_attributes",
    "preferred_central_position",
    "position_ratings.*"
  ],
  "calculated_later": [
    "stats.physical.alcance_de_salto_recomendado_altura",
    "stats.goalkeeping.balones_aereos_recomendado_altura"
  ],
  "not_source_fields": [
    "photo_url",
    "card_photo_url",
    "national_card_photo_url",
    "description"
  ],
  "semantic_exceptions": {
    "juego_sucio": "Keep Football Manager numeric value.",
    "excentricidad": "Keep Football Manager numeric value.",
    "salidas_tendencia": "Keep Football Manager numeric value.",
    "tendencia_a_lesionarse": "Invert during import so the MF LEGACY value follows the project's 20=better convention."
  }
}
