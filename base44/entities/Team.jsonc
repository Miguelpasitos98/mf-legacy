
{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre oficial del equipo"
    },
    "short_name": {
      "type": "string",
      "description": "Nombre corto del equipo"
    },
    "country_id": {
      "type": "string",
      "description": "ID interno del país en Base44"
    },
    "logo": {
      "type": "string",
      "description": "URL del logotipo del equipo"
    },
    "stadium": {
      "type": "string",
      "description": "Nombre del estadio principal"
    },
    "stadium_capacity": {
      "type": "integer",
      "description": "Capacidad del estadio"
    },
    "reputation": {
      "type": "string",
      "enum": [
        "Elite",
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categoría de reputación"
    },
    "market": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categoría de mercado"
    },
    "founded_year": {
      "type": "integer",
      "description": "Año de fundación"
    },
    "fotmob_id": {
      "type": "integer",
      "description": "ID del equipo en FotMob"
    },
    "fotmob_league_id": {
      "type": "integer",
      "description": "ID de la competición principal en FotMob"
    },
    "fotmob_league_name": {
      "type": "string",
      "description": "Nombre de la competición en FotMob"
    },
    "fotmob_url": {
      "type": "string",
      "description": "URL de la página del equipo en FotMob"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "FotMob",
        "Manual",
        "Other"
      ],
      "default": "Manual",
      "description": "Origen de los datos"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el equipo está activo"
    }
  },
  "required": [
    "name",
    "short_name",
    "country_id"
  ]
}
