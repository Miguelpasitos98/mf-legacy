
{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre oficial del equipo"
    },
    "short_name": {
      "type": "string",
      "description": "Nombre corto del equipo"
    },
    "country_id": {
      "type": "string",
      "description": "ID interno del país en Base44"
    },
    "city": {
      "type": "string",
      "description": "Ciudad del equipo"
    },
    "country_map_url": {
  "type": "string",
  "description": "URL de la imagen del contorno del país"
},
"country_team_map_url": {
  "type": "string",
  "description": "URL de la imagen del contorno del país con el escudo del equipo situado en su ciudad"
},
    "logo": {
      "type": "string",
      "description": "URL del escudo del equipo"
    },
    "primary_color": {
      "type": "string",
      "description": "Color principal en formato hexadecimal"
    },
    "secondary_color": {
      "type": "string",
      "description": "Color secundario en formato hexadecimal"
    },
    "kits_overview_url": {
  "type": "string",
  "description": "URL de la imagen única con las tres equipaciones del equipo"
}
    "founded_year": {
      "type": "integer",
      "description": "Año de fundación del equipo"
    },
    "stadium_id": {
      "type": "string",
      "description": "ID interno del estadio asociado"
    },
    "stadium": {
      "type": "string",
      "description": "Nombre del estadio principal"
    },
    "stadium_capacity": {
      "type": "integer",
      "description": "Capacidad del estadio"
    },
    "stadium_built_year": {
      "type": "integer",
      "description": "Año de construcción del estadio"
    },
    "stadium_renovation": {
      "type": "integer",
      "description": "Año de la última remodelación del estadio"
    },
    "pitch_dimensions": {
      "type": "string",
      "description": "Dimensiones del terreno de juego"
    },
    "stadium_interior_url": {
      "type": "string",
      "description": "URL de una imagen del interior del estadio"
    },
    "stadium_exterior_url": {
      "type": "string",
      "description": "URL de una imagen del exterior del estadio"
    },
    "reputation": {
      "type": "string",
      "enum": [
        "Elite",
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categoría de reputación del equipo"
    },
    "market": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categoría de mercado del equipo"
    },
    "history": {
      "type": "string",
      "description": "Historia del equipo en texto enriquecido o HTML"
    },
    "coach_name": {
      "type": "string",
      "description": "Nombre del entrenador actual"
    },
    "coach_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del entrenador"
    },
    "key_player_name": {
      "type": "string",
      "description": "Nombre del jugador clave"
    },
    "key_player_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del jugador clave"
    },
    "captain_name": {
      "type": "string",
      "description": "Nombre del capitán actual"
    },
    "captain_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del capitán"
    },
    "second_captain_name": {
      "type": "string",
      "description": "Nombre del segundo capitán"
    },
    "second_captain_photo_url": {
      "type": "string",
      "description": "URL de la fotografía del segundo capitán"
    },
    "kit1_photo_url": {
      "type": "string",
      "description": "URL de la primera equipación"
    },
    "kit1_shop_url": {
      "type": "string",
      "description": "URL de compra de la primera equipación"
    },
    "kit1_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la primera equipación"
    },
    "kit1_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la primera equipación"
    },
    "kit2_photo_url": {
      "type": "string",
      "description": "URL de la segunda equipación"
    },
    "kit2_shop_url": {
      "type": "string",
      "description": "URL de compra de la segunda equipación"
    },
    "kit2_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la segunda equipación"
    },
    "kit2_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la segunda equipación"
    },
    "kit3_photo_url": {
      "type": "string",
      "description": "URL de la tercera equipación"
    },
    "kit3_shop_url": {
      "type": "string",
      "description": "URL de compra de la tercera equipación"
    },
    "kit3_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la tercera equipación"
    },
    "kit3_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la tercera equipación"
    },
    "fotmob_id": {
      "type": "integer",
      "description": "ID externo del equipo en FotMob, si existe"
    },
    "fotmob_league_id": {
      "type": "integer",
      "description": "ID externo de la liga en FotMob, si existe"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "Manual",
        "FotMob",
        "Other"
      ],
      "default": "Manual",
      "description": "Origen de los datos del equipo"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la ficha del equipo está completa"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el equipo está activo"
    }
  },
  "required": [
    "name",
    "short_name",
    "country_id"
  ]
}
