{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre oficial del equipo"
    },
    "short_name": {
      "type": "string",
      "description": "Nombre corto del equipo"
    },
    "country_id": {
      "type": "string",
      "description": "ID interno del pa\u00eds en Base44"
    },
    "city": {
      "type": "string",
      "description": "Ciudad del equipo"
    },
    "country_map_url": {
      "type": "string",
      "description": "URL de la imagen del contorno del pa\u00eds"
    },
    "country_team_map_url": {
      "type": "string",
      "description": "URL de la imagen del contorno del pa\u00eds con el escudo del equipo situado en su ciudad"
    },
    "logo": {
      "type": "string",
      "description": "URL del escudo del equipo"
    },
    "primary_color": {
      "type": "string",
      "description": "Color principal en formato hexadecimal"
    },
    "secondary_color": {
      "type": "string",
      "description": "Color secundario en formato hexadecimal"
    },
    "founded_year": {
      "type": "integer",
      "description": "A\u00f1o de fundaci\u00f3n del equipo"
    },
    "stadium_id": {
      "type": "string",
      "description": "ID interno del estadio asociado"
    },
    "stadium": {
      "type": "string",
      "description": "Nombre del estadio principal"
    },
    "stadium_capacity": {
      "type": "integer",
      "description": "Capacidad del estadio"
    },
    "stadium_built_year": {
      "type": "integer",
      "description": "A\u00f1o de construcci\u00f3n del estadio"
    },
    "stadium_renovation": {
      "type": "integer",
      "description": "A\u00f1o de la \u00faltima remodelaci\u00f3n del estadio"
    },
    "pitch_dimensions": {
      "type": "string",
      "description": "Dimensiones del terreno de juego"
    },
    "stadium_interior_url": {
      "type": "string",
      "description": "URL de una imagen del interior del estadio"
    },
    "stadium_exterior_url": {
      "type": "string",
      "description": "URL de una imagen del exterior del estadio"
    },
    "reputation": {
      "type": "string",
      "enum": [
        "Elite",
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categor\u00eda de reputaci\u00f3n del equipo"
    },
    "market": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unclassified"
      ],
      "default": "Unclassified",
      "description": "Categor\u00eda de mercado del equipo"
    },
    "history": {
      "type": "string",
      "description": "Historia del equipo en texto enriquecido o HTML"
    },
    "coach_name": {
      "type": "string",
      "description": "Nombre del entrenador actual"
    },
    "coach_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del entrenador"
    },
    "key_player_name": {
      "type": "string",
      "description": "Nombre del jugador clave"
    },
    "key_player_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del jugador clave"
    },
    "captain_name": {
      "type": "string",
      "description": "Nombre del capit\u00e1n actual"
    },
    "captain_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del capit\u00e1n"
    },
    "second_captain_name": {
      "type": "string",
      "description": "Nombre del segundo capit\u00e1n"
    },
    "second_captain_photo_url": {
      "type": "string",
      "description": "URL de la fotograf\u00eda del segundo capit\u00e1n"
    },
    "kit1_photo_url": {
      "type": "string",
      "description": "URL de la primera equipaci\u00f3n"
    },
    "kit1_shop_url": {
      "type": "string",
      "description": "URL de compra de la primera equipaci\u00f3n"
    },
    "kit1_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la primera equipaci\u00f3n"
    },
    "kit1_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la primera equipaci\u00f3n"
    },
    "kit2_photo_url": {
      "type": "string",
      "description": "URL de la segunda equipaci\u00f3n"
    },
    "kit2_shop_url": {
      "type": "string",
      "description": "URL de compra de la segunda equipaci\u00f3n"
    },
    "kit2_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la segunda equipaci\u00f3n"
    },
    "kit2_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la segunda equipaci\u00f3n"
    },
    "kit3_photo_url": {
      "type": "string",
      "description": "URL de la tercera equipaci\u00f3n"
    },
    "kit3_shop_url": {
      "type": "string",
      "description": "URL de compra de la tercera equipaci\u00f3n"
    },
    "kit3_badge_bg": {
      "type": "string",
      "description": "Color de fondo de la etiqueta de la tercera equipaci\u00f3n"
    },
    "kit3_badge_text": {
      "type": "string",
      "description": "Color del texto de la etiqueta de la tercera equipaci\u00f3n"
    },
    "fotmob_id": {
      "type": "integer",
      "description": "ID externo del equipo en FotMob, si existe"
    },
    "fotmob_league_id": {
      "type": "integer",
      "description": "ID externo de la liga en FotMob, si existe"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "Manual",
        "FotMob",
        "Other"
      ],
      "default": "Manual",
      "description": "Origen de los datos del equipo"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la ficha del equipo est\u00e1 completa"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el equipo est\u00e1 activo"
    }
  },
  "required": [
    "name",
    "short_name",
    "country_id"
  ]
}