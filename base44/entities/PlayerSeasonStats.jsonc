{
  "name": "PlayerSeasonStats",
  "type": "object",
  "properties": {
    "external_record_id": {
      "type": "string",
      "description": "Clave \u00fanica l\u00f3gica jugador FotMob + equipo + temporada + competici\u00f3n; usada para evitar duplicados"
    },
    "player_id": {
      "type": "string",
      "description": "ID Base44 Player confirmado, no se deduce solo por nombre"
    },
    "fm26_uid": {
      "type": "string"
    },
    "fotmob_player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "fotmob_team_id": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "appearances": {
      "type": "number"
    },
    "minutes": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "market_value": {
      "type": "number"
    },
    "market_date": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "per90": {
            "type": "number"
          },
          "percentile": {
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "provider_minutes": {
            "type": "number"
          },
          "verification_status": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "string"
    },
    "verification_status": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "import_batch": {
      "type": "string"
    },
    "updated_from_file": {
      "type": "string"
    },
    "team_matches": {
      "type": "number",
      "minimum": 1,
      "maximum": 200,
      "description": "Partidos reales disputados por el equipo (NO el jugador) en esa temporada y competici\u00f3n. Opcional y verificado; se usa como denominador de Play %."
    },
    "fifa_fc_overall": {
      "type": "number",
      "description": "Overall hist\u00f3rico por jugador-temporada. No es rating FotMob ni CA/PA FM26."
    },
    "transfermarkt_value_eur": {
      "type": "number",
      "description": "Valor hist\u00f3rico Transfermarkt en EUR por jugador-temporada, no precio de traspaso."
    },
    "historical_valuation_source": {
      "type": "string"
    },
    "historical_valuation_status": {
      "type": "string"
    },
    "historical_valuation_edition": {
      "type": "string"
    },
    "historical_valuation_date": {
      "type": "string"
    },
    "manual_metric_history": {
      "type": "array",
      "description": "Historical audit trail of administrator edits; source FotMob metrics remain traceable.",
      "items": {
        "type": "object",
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "old_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "new_value": {
            "type": "number"
          },
          "source_note": {
            "type": "string"
          },
          "changed_at": {
            "type": "string"
          }
        }
      }
    },
    "national_team_id": {
      "type": "string",
      "description": "NationalTeam.id para competiciones de selecci\u00f3n, independiente del club Team"
    },
    "national_country_id": {
      "type": "string",
      "description": "Country.id vinculado a la selecci\u00f3n"
    },
    "display_season": {
      "type": "string",
      "description": "Temporada deportiva mostrada YYYY/YYYY; override manual sin cambiar el a\u00f1o de origen ni external_record_id"
    }
  },
  "required": [
    "external_record_id",
    "player_id",
    "season",
    "competition"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}